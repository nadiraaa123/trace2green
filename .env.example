# --- Client (public) Firebase web config ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Set to true for local development against `npm run emulators`
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# Optional: pretend "today" is this date (YYYY-MM-DD) for reporting periods.
# Use 2027-04-05 to demo next to the simulated Jan–Mar 2027 dataset. Empty = real date.
# Build-time value: rebuild after changing it.
NEXT_PUBLIC_REPORTING_REFERENCE_DATE=

# --- Server only (never prefix with NEXT_PUBLIC_) ---
# base64 of the service account JSON: base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_KEY=

# Local emulator (server side). Leave empty in production.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Server-only, demo only: allow the workbook's SIMULATED group average as a clearly
# labeled intensity benchmark for live reports. Leave unset/false in production.
DEMO_SIMULATED_BENCHMARK=false
