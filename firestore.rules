rules_version = '2';

// Trace2Green security rules.
// Authorization comes ONLY from custom claims set by the server
// (role, companyId, supplierId). The users/{uid} doc is display data.
// Privileged writes (submission, verification, scoring, sharing) go through
// server routes using the Admin SDK and are denied here.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function claim(k) { return signedIn() && k in request.auth.token ? request.auth.token[k] : null; }
    function isAdmin() { return claim('role') == 'platform_admin'; }
    function isCompany() { return claim('role') == 'company_admin' && claim('companyId') is string; }
    function isSupplierOf(sid) { return claim('role') == 'supplier' && claim('supplierId') == sid; }
    function myCompany() { return request.auth.token.companyId; }

    // Report-family docs carry sharedWith: [companyId], written only by the server
    // from consent records. Company queries must use array-contains on it.
    function companyCanRead(data) {
      return isCompany() && data.get('sharedWith', []).hasAny([myCompany()]);
    }
    function ownsDoc(data) { return isSupplierOf(data.get('supplierId', '')); }
    // Doc IDs of report-family docs start with "<supplierId>_" (supplier IDs have no "_").
    function idOwner(id) { return id.split('_')[0]; }

    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }
    function optNum(m, k) { return !(k in m) || m[k] == null || (m[k] is number && m[k] >= 0 && m[k] < 1000000000); }
    function optStr(m, k, max) { return !(k in m) || m[k] == null || (m[k] is string && m[k].size() <= max); }

    function validActivity(a) {
      return a is map
        && a.keys().hasOnly(['electricityKwh','fuelQuantity','fuelUnit','fuelType','packagingKg','packagingMaterial',
                             'wasteKg','wasteHandling','rawMaterialOrigin','transportMode','transportKm',
                             'efficiencyPractice','notApplicable'])
        && optNum(a,'electricityKwh') && optNum(a,'fuelQuantity') && optNum(a,'packagingKg')
        && optNum(a,'wasteKg') && optNum(a,'transportKm')
        && optStr(a,'packagingMaterial',80) && optStr(a,'wasteHandling',80)
        && (!('fuelUnit' in a) || a.fuelUnit in [null,'liter','kg'])
        && (!('fuelType' in a) || a.fuelType in [null,'Bensin','Solar','LPG','Lainnya'])
        && (!('rawMaterialOrigin' in a) || a.rawMaterialOrigin in [null,'Lokal','Regional','Impor'])
        && (!('transportMode' in a) || a.transportMode in [null,'Motor','Mobil bak','Truk'])
        && (!('efficiencyPractice' in a) || a.efficiencyPractice in [null,'Belum','Sebagian','Sudah ada'])
        && (!('notApplicable' in a) || (a.notApplicable is list && a.notApplicable.size() <= 5
             && a.notApplicable.hasOnly(['listrik','bbm','kemasan','limbah','transportasi'])));
    }
    function validProfile(p) {
      return p is map
        && p.keys().hasOnly(['businessName','sector','mainProduct','productionVolume','productionUnit','employees'])
        && optStr(p,'businessName',120) && optStr(p,'sector',60) && optStr(p,'mainProduct',120)
        && optStr(p,'productionUnit',30) && optNum(p,'productionVolume') && optNum(p,'employees');
    }

    // ---------- identity ----------
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow write: if false;
    }

    match /companies/{companyId} {
      allow read: if (isCompany() && myCompany() == companyId) || isAdmin();
      allow write: if false;
    }

    match /suppliers/{supplierId} {
      allow read: if isSupplierOf(supplierId)
                  || (isCompany() && resource.data.get('linkedCompanies', []).hasAny([myCompany()]))
                  || isAdmin();
      allow update: if isSupplierOf(supplierId)
                    && resource.data.ownerUid == request.auth.uid
                    && onlyChanges(['businessName','picName','sector','region','whatsapp','mainProduct','employees','updatedAt'])
                    && request.resource.data.businessName is string
                    && request.resource.data.businessName.size() >= 2
                    && optNum(request.resource.data, 'employees');
      allow create, delete: if false;
    }

    match /company_supplier_relationships/{id} {
      allow read: if (isCompany() && resource.data.companyId == myCompany())
                  || ownsDoc(resource.data) || isAdmin();
      allow write: if false;
    }

    match /supplier_data_sharing_consents/{id} {
      allow read: if (isCompany() && resource.data.companyId == myCompany())
                  || ownsDoc(resource.data) || isAdmin();
      allow write: if false; // grant/revoke via server so sharedWith stays consistent
    }

    match /supplier_invites/{id} { allow read, write: if false; }
    match /meta/counters { allow read, write: if false; }

    // ---------- reporting ----------
    match /monthly_reports/{rid} {
      allow get: if isSupplierOf(idOwner(rid)) || (resource != null && companyCanRead(resource.data)) || isAdmin();
      allow list: if ownsDoc(resource.data) || companyCanRead(resource.data) || isAdmin();

      // Supplier creates a draft for itself; ID fixed to <supplierId>_<YYYY-MM>,
      // so a second report for the same month is impossible.
      allow create: if isSupplierOf(request.resource.data.supplierId)
        && rid == request.resource.data.supplierId + '_' + request.resource.data.period
        && request.resource.data.period.matches('^20[0-9]{2}-(0[1-9]|1[0-2])$')
        && request.resource.data.keys().hasOnly(['reportId','supplierId','period','status','profile','activity',
                                                 'draftStep','version','sharedWith','submittedAt',
                                                 'dataSource','isSimulated','createdAt','updatedAt'])
        && request.resource.data.reportId == rid
        && request.resource.data.status == 'draft'
        && request.resource.data.version == 0
        && request.resource.data.sharedWith.size() == 0
        && request.resource.data.submittedAt == null
        && request.resource.data.dataSource == 'trial'
        && request.resource.data.isSimulated == false
        && validProfile(request.resource.data.profile)
        && validActivity(request.resource.data.activity);

      // Editing is allowed only while draft / revision requested, and never the status.
      allow update: if isSupplierOf(resource.data.supplierId)
        && resource.data.status in ['draft', 'revision_requested']
        && onlyChanges(['profile','activity','draftStep','updatedAt'])
        && validProfile(request.resource.data.profile)
        && validActivity(request.resource.data.activity);

      allow delete: if isSupplierOf(resource.data.supplierId) && resource.data.status == 'draft';

      match /versions/{v} {
        allow read: if ownsDoc(resource.data) || companyCanRead(resource.data) || isAdmin();
        allow write: if false;
      }
    }

    // Server-computed, read-only for clients.
    match /activity_records/{id}      { allow read: if ownsDoc(resource.data) || companyCanRead(resource.data) || isAdmin(); allow write: if false; }
    match /emission_results/{id}      { allow read: if ownsDoc(resource.data) || companyCanRead(resource.data) || isAdmin(); allow write: if false; }
    match /supplier_scores/{id}       { allow read: if ownsDoc(resource.data) || companyCanRead(resource.data) || isAdmin(); allow write: if false; }
    match /recommendations/{id}       { allow read: if ownsDoc(resource.data) || companyCanRead(resource.data) || isAdmin(); allow write: if false; }
    match /verification_records/{id}  { allow read: if ownsDoc(resource.data) || companyCanRead(resource.data) || isAdmin(); allow write: if false; }

    match /evidence_metadata/{id} {
      allow read: if ownsDoc(resource.data) || companyCanRead(resource.data) || isAdmin();
      allow create: if isSupplierOf(request.resource.data.supplierId)
        && idOwner(request.resource.data.reportId) == request.resource.data.supplierId
        && request.resource.data.keys().hasOnly(['supplierId','reportId','kind','fileName','mimeType','sizeBytes',
                                                 'storageMode','sharedWith','dataSource','isSimulated','createdAt'])
        && request.resource.data.fileName is string && request.resource.data.fileName.size() <= 200
        && request.resource.data.mimeType in ['image/jpeg','image/png','image/webp','image/heic','application/pdf']
        && exists(/databases/$(database)/documents/monthly_reports/$(request.resource.data.reportId))
        && get(/databases/$(database)/documents/monthly_reports/$(request.resource.data.reportId)).data.status in ['draft','revision_requested']
        && request.resource.data.kind in ['tagihan_listrik','nota_bbm','bukti_material','lainnya']
        // Clients may only record demo previews; real storage is written by the server later.
        && request.resource.data.storageMode == 'demo_preview'
        && request.resource.data.sharedWith.size() == 0
        && request.resource.data.isSimulated == false
        && request.resource.data.sizeBytes is int && request.resource.data.sizeBytes > 0
        && request.resource.data.sizeBytes <= 5242880;
      allow delete: if ownsDoc(resource.data) && resource.data.sharedWith.size() == 0;
      allow update: if false;
    }

    // ---------- reference data ----------
    match /emission_factors/{id} { allow read: if signedIn(); allow write: if false; }
    match /benchmarks/{id}       { allow read: if signedIn(); allow write: if false; }
    match /meta/scoring_params   { allow read: if signedIn(); allow write: if false; }

    // ---------- notifications & logs ----------
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.recipientUid == request.auth.uid;
      allow update: if signedIn() && resource.data.recipientUid == request.auth.uid
                    && onlyChanges(['read', 'readAt']) && request.resource.data.read == true;
      allow create, delete: if false;
    }
    match /audit_logs/{id} { allow read: if isAdmin(); allow write: if false; }
    match /sync_logs/{id}  { allow read: if isAdmin(); allow write: if false; }

    // Default deny for anything not listed above.
  }
}
