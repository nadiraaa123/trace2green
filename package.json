    "eslint-config-next": "16.4.6",
    "firebase-tools": "^15.36.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0",
    "xlsx": "^0.18.5"
  },
  "overrides": {
